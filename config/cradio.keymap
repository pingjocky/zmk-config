#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    behaviors {
        hrml: hrml {
            compatible = "zmk,behavior-hold-tap";
            label = "HRML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 32 33>;
        };

        hrmr: hrmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HRMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31>;
        };
    };

    macros {
        TA_ART: TA_ART {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(A) &kp LS(R) &kp LS(T) &kp MINUS &kp LS(T) &kp LS(A) &kp SPACE>;
            label = "TA_ART";
        };

        NO_TA_SR: NO_TA_SR {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp LS(O) &kp SPACE &kp LS(T) &kp LS(A) &kp SPACE &kp LS(S) &kp LS(R)>;
            label = "NO_TA_SR";
        };

        other: other {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(O) &kp T &kp H>,
                <&macro_wait_time 100>,
                <&kp TAB>;

            label = "OTHER";
        };

        charge: charge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp LS(L) &kp LS(E) &kp LS(A) &kp LS(S) &kp LS(E) &kp SPACE &kp LS(B) &kp LS(I) &kp LS(L) &kp LS(L) &kp SPACE &kp LS(T) &kp LS(H) &kp LS(E) &kp SPACE &kp LS(C) &kp LS(O) &kp LS(R) &kp LS(R) &kp LS(E) &kp LS(C) &kp LS(T) &kp SPACE &kp LS(A) &kp LS(M) &kp LS(O) &kp LS(U) &kp LS(N) &kp LS(T) &kp SPACE &kp LS(F) &kp LS(O) &kp LS(R) &kp SPACE &kp LS(M) &kp LS(Y) &kp SPACE &kp LS(T) &kp LS(I) &kp LS(M) &kp LS(E)>;
            label = "CHARGE";
        };

        no_charge: no_charge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(P) &kp LS(L) &kp LS(E) &kp LS(A) &kp LS(S) &kp LS(E) &kp SPACE &kp LS(D) &kp LS(O) &kp SPACE &kp LS(N) &kp LS(O) &kp LS(T) &kp SPACE &kp LS(B) &kp LS(I) &kp LS(L) &kp LS(L) &kp SPACE &kp LS(F) &kp LS(O) &kp LS(R) &kp SPACE &kp LS(M) &kp LS(Y) &kp SPACE &kp LS(T) &kp LS(I) &kp LS(M) &kp LS(E) &kp COMMA &kp SPACE &kp LS(T) &kp LS(E) &kp LS(C) &kp LS(H) &kp SPACE &kp LS(N) &kp LS(E) &kp LS(E) &kp LS(D) &kp LS(E) &kp LS(D) &kp SPACE &kp LS(O) &kp LS(N) &kp SPACE &kp LS(S) &kp LS(I) &kp LS(T) &kp LS(E)>;
            label = "NO_CHARGE";
        };

        invoice: invoice {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp E &kp C &kp H &kp SPACE &kp LS(A) &kp D &kp V &kp I &kp S &kp O &kp R &kp SPACE &kp LS(C) &kp A &kp L &kp L &kp SPACE &kp MINUS &kp SPACE &kp MINUS &kp SPACE &kp MINUS &kp SPACE &kp LS(P) &kp LS(O) &kp LS(C) &kp SPACE>;
            label = "INVOICE";
        };

        script: script {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp C &kp R &kp E &kp A &kp T &kp E &kp UNDER &kp C &kp A &kp L &kp L &kp UNDER &kp L &kp O &kp G &kp DOT &kp C &kp M &kp D>,
                <&macro_wait_time 100>,
                <&kp ENTER>;

            label = "SCRIPT";
        };

        done: done {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp STAR &kp STAR &kp LS(D) &kp LS(O) &kp LS(N) &kp LS(E) &kp STAR &kp STAR>,
                <&macro_wait_time 100>,
                <&kp ENTER>;

            label = "DONE";
        };

        mute: mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LALT &kp M>;
            label = "MUTE";
        };

        screenl: screenl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LGUI &kp LCTRL &kp LEFT>;
            label = "SCREENL";
        };

        screenr: screenr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RGUI &kp RCTRL &kp RIGHT>;
            label = "SCREENR";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_Layer {
            bindings = <
&kp Q             &kp W             &kp E          &kp R               &kp T        &kp Y      &kp U                &kp I          &kp O              &kp P
&hrml LEFT_WIN A  &hrml LEFT_ALT S  &hrml LCTRL D  &hrml LEFT_SHIFT F  &lt 2 G      &kp H      &hrmr RIGHT_SHIFT J  &hrmr RCTRL K  &hrmr RIGHT_ALT L  &hrmr RIGHT_WIN SQT
&lt 3 Z           &kp X             &kp C          &kp V               &kp B        &kp N      &kp M                &kp COMMA      &kp DOT            &kp FSLH
                                                   &lt 1 TAB           &kp ENTER    &kp SPACE  &kp BACKSPACE
            >;
        };

        layer_1 {
            bindings = <
&kp ESC       &other   &no_charge  &charge  &TA_ART      &done           &kp HOME  &kp END       &kp GRAVE  &kp PG_UP
&kp CAPSLOCK  &trans   &trans      &trans   &NO_TA_SR    &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW  &kp RIGHT  &kp PG_DN
&trans        &script  &invoice    &trans   &trans       &trans          &mute     &screenl      &screenr   &kp DEL
                                   &trans   &trans       &trans          &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &kp MINUS  &kp N7        &kp N8  &kp N9  &kp LBKT
&trans  &trans  &trans  &trans  &trans    &kp EQUAL  &kp N4        &kp N5  &kp N6  &kp RBKT
&trans  &trans  &trans  &trans  &trans    &kp N0     &kp NUMBER_1  &kp N2  &kp N3  &kp BSLH
                        &trans  &trans    &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans      &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans    &trans      &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3
                        &trans  &trans    &trans      &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };
    };
};
